{
    "name": "majoskorec/monter",
    "description": "personal homepage",
    "license": "proprietary",
    "type": "project",
    "homepage": "https://github.com/majoskorec/monter",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "doctrine/doctrine-bundle": "^3.1",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.2",
        "phpdocumentor/reflection-docblock": "^5.6",
        "symfony/asset": "~8.0.0",
        "symfony/asset-mapper": "~8.0.0",
        "symfony/console": "~8.0.0",
        "symfony/dotenv": "~8.0.0",
        "symfony/expression-language": "~8.0.0",
        "symfony/flex": "^2",
        "symfony/form": "~8.0.0",
        "symfony/framework-bundle": "~8.0.0",
        "symfony/http-client": "~8.0.0",
        "symfony/intl": "~8.0.0",
        "symfony/mime": "~8.0.0",
        "symfony/monolog-bundle": "^4.0",
        "symfony/process": "~8.0.0",
        "symfony/property-access": "~8.0.0",
        "symfony/property-info": "~8.0.0",
        "symfony/runtime": "~8.0.0",
        "symfony/security-bundle": "~8.0.0",
        "symfony/serializer": "~8.0.0",
        "symfony/string": "~8.0.0",
        "symfony/translation": "~8.0.0",
        "symfony/twig-bundle": "~8.0.0",
        "symfony/ux-turbo": "^2.7",
        "symfony/validator": "~8.0.0",
        "symfony/web-link": "~8.0.0",
        "symfony/yaml": "~8.0.0",
        "symfonycasts/sass-bundle": "^0.9.0",
        "twig/extra-bundle": "^3.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.29",
        "friendsofphp/php-cs-fixer": "^3.59",
        "friendsoftwig/twigcs": "^6.2",
        "php-parallel-lint/php-parallel-lint": "^1.3",
        "phpro/grumphp": "^2.6",
        "phpstan/extension-installer": "^1.2",
        "phpstan/phpdoc-parser": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "pixelfederation/coding-standards": "^5.0",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/browser-kit": "~8.0.0",
        "symfony/css-selector": "~8.0.0",
        "symfony/debug-bundle": "~8.0.0",
        "symfony/maker-bundle": "^1.0",
        "symfony/phpunit-bridge": "~8.0.0",
        "symfony/stopwatch": "~8.0.0",
        "symfony/web-profiler-bundle": "~8.0.0",
        "vimeo/psalm": "^6.13",
        "weirdan/doctrine-psalm-plugin": "^2.10"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "phpro/grumphp": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.0.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        }
    }
}
